# Dependencies
node_modules/

# Build output
dist/
.vite/

# Local database — regenerated on first boot
*.db
*.db-journal

# NOTE: temp/ is intentionally NOT ignored. It holds the reference photos used to
# compute the perceptual hashes in frontend/src/lib/presets.js. The site never
# loads them at runtime; they are kept for reference and reproducibility.

# Environment — keep real secrets out, but the checked-in defaults are safe to
# share (they only ever hold a localhost URL or a public endpoint).
.env
.env.local
.env.*.local
.env.*
!.env.example
!.env.development

# Editor / OS
.DS_Store
Thumbs.db
*.log
npm-debug.log*