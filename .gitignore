# Dependencies
node_modules/

# Build output
dist/
.vite/

# Local database — regenerated on first boot
*.db
*.db-journal

# Reference photos used for the hardcoded demo presets. These are personal club
# photos and must never be committed or deployed.
temp/

# Environment — keep real secrets out, but the checked-in defaults are safe to
# share (they only ever hold a localhost URL or a public endpoint).
.env
.env.local
.env.*.local
.env.*
!.env.example
!.env.development

# Editor / OS
.DS_Store
Thumbs.db
*.log
npm-debug.log*